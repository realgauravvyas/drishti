# Copy to .env and edit, or just export these before running.
# Every setting is optional; the defaults shown are what you get with none.

# --- storage --------------------------------------------------------------
SMRITI_DATA_DIR=./data          # photos, thumbnails, smriti.db, weights, secret.key
# SMRITI_WEIGHTS_DIR=./data/weights

# --- face engine ----------------------------------------------------------
# sface        default; ~40 MB of weights, no extra pip installs, ~30 ms/photo
# arcface      512-d ArcFace R50; needs onnxruntime + a 166 MB download, ~340 ms/photo
# insightface  same weights via the insightface package
# mock         no ML at all; used by the test suite
SMRITI_ENGINE=sface

SMRITI_DETECT_SIZE=1280         # longest side used for detection; raise to find smaller faces
SMRITI_DET_SCORE_MIN=0.60       # reject detections below this confidence
SMRITI_MIN_FACE_PX=28           # ignore faces smaller than this on the original image

# --- matching -------------------------------------------------------------
SMRITI_MATCH_THRESHOLD=0        # 0 = use the engine's calibrated default
SMRITI_MAX_RESULTS=500

# --- ingest ---------------------------------------------------------------
SMRITI_WORKERS=4                # background indexing threads; defaults to half your cores
SMRITI_THUMB_PX=480
SMRITI_MAX_UPLOAD_MB=40

# --- privacy / lifecycle --------------------------------------------------
SMRITI_RETENTION_DAYS=30        # auto-delete events this long after creation; 0 = never
SMRITI_STORE_SELFIES=0          # keep this off. On means guest selfies hit the disk.

# --- server ---------------------------------------------------------------
SMRITI_HOST=127.0.0.1           # 0.0.0.0 to accept connections from phones on your Wi-Fi
SMRITI_PORT=8000
SMRITI_PUBLIC_URL=              # e.g. https://photos.example.com -- used to build share links
SMRITI_CORS_ORIGINS=            # comma-separated; leave empty unless a separate frontend calls the API

# Set to any value to refuse downloading weights at runtime (air-gapped installs).
# SMRITI_OFFLINE=1
